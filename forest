scene.background.copy(skyC);scene.fog.color.copy(skyC);hemi.intensity=.35+.6*dayF;sun.intensity=.08+.75*dayF;
fm.opacity=Math.max(0,.95-dayF*1.6)*(.75+.25*Math.sin(t*3));
for(let i=0;i<FN;i++){fp[i*3]+=Math.sin(t*.6+fph[i])*dt*.3;fp[i*3+1]=fb[i]+Math.sin(t*.9+fph[i])*.5;fp[i*3+2]+=Math.cos(t*.5+fph[i])*dt*.3}
fg.attributes.position.needsUpdate=true;
shafts.forEach((m,i)=>m.material.opacity=Math.max(0,dayF-.35)*.13*(.6+.4*Math.sin(t*.5+i)));
for(let i=0;i<LN;i++){const l=LS[i];l.y-=dt*(.5+l.s*.5);l.x+=Math.sin(t*.8+i)*dt*.6;if(l.y<0){l.y=17;l.x=pos.x+(rnd()-.5)*50;l.z=pos.z+(rnd()-.5)*50}
d.position.set(l.x,l.y,l.z);d.rotation.set(t*l.s*2+i,t*l.s+i,0);d.scale.setScalar(1);d.updateMatrix();leaves.setMatrixAt(i,d.matrix)}
leaves.instanceMatrix.needsUpdate=true;d.rotation.set(0,0,0);
if(!AC||muted)return;
const L=AC.listener;camera.getWorldDirection(fw2);
if(L.positionX){L.positionX.value=pos.x;L.positionY.value=pos.y;L.positionZ.value=pos.z;L.forwardX.value=fw2.x;L.forwardY.value=fw2.y;L.forwardZ.value=fw2.z;L.upX.value=0;L.upY.value=1;L.upZ.value=0}
if(walking){stepT-=dt;if(stepT<=0){stepT=.52;nz({d:.09,g:.13,f:380+Math.random()*150,f1:200,q:.9})}
pingT-=dt;let best=null,bd=1e9;for(const k in OBJ){if(found.has(k))continue;const dd=OBJ[k].position.distanceTo(pos);if(dd<bd){bd=dd;best=k}}
if(best&&bd<16&&pingT<=0){pingT=Math.max(.7,bd/7);at(OBJ[best],()=>tone({type:'sine',f0:880,f1:1320,d:.25,g:.07}))}}
gustT-=dt;if(gustT<=0){gustT=5+Math.random()*6;nz({d:3,g:.07,f:200,f1:650,q:.5})}
ambT-=dt;if(ambT<=0){ambT=1.6+Math.random()*1.4;if(dayF>.45){if(Math.random()<.6)at(rp(),bird)}else{at(rp(),cricket);if(Math.random()<.18)at(rp(),owl)}}}

const clock=new T.Clock();
(function frame(){
    requestAnimationFrame(frame);
    const dt=Math.min(clock.getDelta(),.05),t=clock.elapsedTime;
    if(!started) yaw+=dt*.08;
    camera.position.copy(pos); orient(); walk(dt,t); camera.position.copy(pos);
    animate(dt,t); world(dt,t); gaze(dt); render();
})();

function setVR(v){vr=v;document.body.classList.toggle('vr',v);$('#bVR').classList.toggle('on',v);camera.fov=v?80:70;
if(v){try{const el=document.documentElement;(el.requestFullscreen||el.webkitRequestFullscreen).call(el)}catch(e){}try{screen.orientation.lock('landscape').catch(()=>{})}catch(e){}}}

async function begin(v){
    try{if(typeof DeviceOrientationEvent!=='undefined'&&typeof DeviceOrientationEvent.requestPermission==='function')await DeviceOrientationEvent.requestPermission()}catch(e){}
    if(!AC)initAudio(); AC.resume(); a0=null; yaw=0; started=true; $('#intro').style.display='none'; setVR(v); setHint();
    
    // إرشادات البداية تظهر كصوت ونص
    setTimeout(()=>{
        say('أهلاً بك في الغابة! اضغط على الشاشة للمشي، واضغط للتوقف. ابحث عن الحيوانات الأربعة وتأملها.', true, ()=>{});
    }, 1000);
}

$('#go').onclick=()=>begin(false); $('#goVR').onclick=()=>begin(true);
$('#bVR').onclick=()=>setVR(!vr);

$('#bSnd').onclick=e=>{muted=!muted; e.currentTarget.textContent=muted?'🔇':'🔊'; if(master)master.gain.value=muted?0:.55; if(muted&&'speechSynthesis'in window)speechSynthesis.cancel()};
$('#bRe').onclick=()=>{if(lastNote){setNote(lastNote); say(lastNote.t, false, ()=>{noteTimer=setTimeout(hideNote,5000)})}};
$('#bFs').onclick=()=>{const el=document.documentElement;try{document.fullscreenElement?document.exitFullscreen():(el.requestFullscreen||el.webkitRequestFullscreen).call(el)}catch(e){}};
$('#bRst').onclick=()=>{
    found.clear(); $$('.stars .n').forEach(e=>e.textContent=0);
    $$('.c').forEach(e=>e.classList.remove('on'));
    hideNote(); $$('.subtitle').forEach(s=>s.classList.remove('on'));
    if(window.speechSynthesis) speechSynthesis.cancel();
    pos.set(0, 1.6, 0); yaw = 0; pitch = 0; walking = false; setHint();
};
</script>
