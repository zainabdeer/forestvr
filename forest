<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>غابة الواقع الافتراضي</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@500;800&display=swap">
<style>
:root{--bg:#0b1a10;--ink:#f3fbe9;--card:rgba(8,28,14,.78);--gold:#ffd54a;--leaf:#7bd88f}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font-family:Tajawal,"Segoe UI",Tahoma,sans-serif;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none}
canvas{position:fixed;inset:0;width:100%;height:100%;display:block}
.hud{position:fixed;top:0;bottom:0;left:0;right:0;pointer-events:none}
#hudR{display:none}
.vr .hud{width:50%}
.vr #hudL{right:auto}
.vr #hudR{display:block;left:auto}
.stars{position:absolute;top:calc(12px + env(safe-area-inset-top,0px));right:12px;background:var(--card);border-radius:999px;padding:6px 12px;font-weight:800;font-size:16px;display:flex;gap:8px;align-items:center}
.stars .c{opacity:.3;filter:grayscale(1);transition:.4s}
.stars .c.on{opacity:1;filter:none;transform:scale(1.15)}
.cross{position:absolute;left:50%;top:50%;width:56px;height:56px;margin:0;transform:translate(-50%,-50%);display:grid;place-items:center}
.cross svg{position:absolute;inset:0;width:100%;height:100%;display:block;transform:rotate(-90deg)}
.cross circle{fill:none;stroke-width:4}
.cross .bg{stroke:rgba(255,255,255,.55)}
.cross .ring{stroke:var(--gold);stroke-dasharray:125.7;stroke-dashoffset:125.7;stroke-linecap:round}
.cross i{position:absolute;left:50%;top:50%;width:6px;height:6px;margin:0;transform:translate(-50%,-50%);border-radius:50%;background:#fff}
.hint{position:absolute;top:calc(62px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);background:var(--card);border-radius:999px;padding:5px 14px;font-size:14px;white-space:nowrap; border: 1px solid var(--leaf); color: var(--leaf);}
.subtitle{position:absolute;top:calc(110px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.8);border:2px solid var(--gold);color:#fff;border-radius:12px;padding:8px 16px;font-size:16px;text-align:center;width:80%;max-width:400px;opacity:0;transition:0.4s;pointer-events:none;font-weight:800;line-height:1.5;}
.subtitle.on{opacity:1;}
.note{position:absolute;bottom:calc(14px + env(safe-area-inset-bottom,0px));left:50%;width:min(92%,560px);transform:translate(-50%,24px);opacity:0;transition:.5s;background:var(--card);backdrop-filter:blur(6px);border-radius:18px;padding:12px 18px;line-height:1.75}
.note.on{opacity:1;transform:translate(-50%,0)}
.note b{display:block;color:var(--gold);font-size:21px;font-weight:800}
.note p{margin:2px 0 0;font-size:17px}
.vr .note p{font-size:12px;line-height:1.55}.vr .note b{font-size:15px}.vr .note{padding:8px 12px}
.vr .hint{font-size:11px;padding:3px 8px}
.vr .subtitle{font-size:12px; padding:6px 10px; top:80px;}
#bar{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:5}
#bar button{width:42px;height:42px;border-radius:50%;border:0;background:var(--card);color:var(--ink);font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;line-height:1;text-align:center}
#bar button.on{background:var(--leaf);color:#0b1a10}
#intro{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(6,20,10,.55);backdrop-filter:blur(3px);overflow:auto}
.card{max-width:460px;text-align:center}
.card h1{font-size:clamp(34px,8vw,52px);line-height:1.15;margin:0 0 6px;font-weight:800;color:#e9ffd0;text-shadow:0 3px 18px #000}
.card p{margin:0 0 14px;font-size:18px;line-height:1.7}
.card ul{list-style:none;margin:0 0 18px;padding:0;text-align:right;background:var(--card);border-radius:18px;padding:12px 18px;font-size:16px;line-height:2}
.card button{font:inherit;font-weight:800;font-size:20px;border:0;border-radius:16px;padding:13px 22px;margin:4px;cursor:pointer}
#go{background:var(--gold);color:#2a2100}
#goVR{background:var(--leaf);color:#0b2a12}
.small{font-size:13px!important;opacity:.8;margin-top:10px!important}
#rot{display:none;position:fixed;inset:0;z-index:8;background:rgba(6,20,10,.92);align-items:center;justify-content:center;font-size:22px;font-weight:800;text-align:center;padding:30px}
@media (orientation:portrait){.vr #rot{display:flex}}
</style>
</head>
<body>
<div id="hudL" class="hud"></div><div id="hudR" class="hud"></div>
<div id="bar">
    <button id="bRst" title="إعادة الجولة">🔄</button>
    <button id="bVR" title="وضع النظارة">🥽</button>
    <button id="bSnd" title="الصوت">🔊</button>
    
    <button id="bRe" title="أعد الملاحظة">🔁</button>
    <button id="bFs" title="ملء الشاشة">⛶</button>
</div>
<div id="rot">↻ أدر هاتفك بالعرض لتظهر الغابة بعينين</div>
<div id="intro"><div class="card">
<h1>غابة الواقع الافتراضي</h1>
<p>جولة بين الأشجار، وأربعة أصدقاء ينتظرون أن تكتشفهم!</p>
<ul>
    <li>📱 حرّك هاتفك لتنظر حولك في كل اتجاه</li>
    <li>👆 اضغط على الشاشة للمشي، واضغط مرة أخرى للتوقف</li>
    <li>🎯 ركّز الدائرة على حيوان ثانية واحدة لتكتشفه</li>
    <li>🎧 السماعات تجعل الرحلة أجمل</li>
</ul>
<button id="go">🌿 ابدأ الجولة</button><button id="goVR">🥽 وضع النظارة</button>
</div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const T=THREE,$=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];

const A={
wood:{n:'نقار الخشب',e:'🐦',t:'نقّار الخشب ينقر جذع الشجرة بمنقاره القوي ليأكل الحشرات المختبئة داخل الخشب. وهو يحفر في الجذع عشّه الدافئ ليربّي فيه صغاره. الشجرة بيته وطعامه!'},
monkey:{n:'القرد',e:'🐵',t:'القرد يعيش فوق الأشجار، ويتدلى من أغصانها بأمان. يأكل الثمار اللذيذة وينام بين الأوراق. الأشجار بيت القرد وطعامه.'},
bear:{n:'الدب',e:'🐻',t:'الدب يتسلّق الأشجار بمخالبه القوية ليصل إلى الثمار الحلوة وإلى العسل الذي يصنعه النحل. الأشجار تمنح الدب طعامًا لذيذًا.'},
lion:{n:'الأسد',e:'🦁',t:'الأسد يرتاح في ظل الأشجار بعيدًا عن حرارة الشمس. الأشجار تمنحه مكانًا هادئًا ليستريح ويراقب الغابة.'}};

const WIN={n:'🎉 أحسنت يا بطل!',t:'اكتشفت جميع الحيوانات! نستنتج أن الحيوانات في الغابة تعتمد على الأشجار في طعامها ومسكنها. هيا نحافظ على الغابات!'};

const hudHTML=`
<div class="stars">⭐ <span class="n">0</span>/4 <span class="c" data-k="wood">🐦</span><span class="c" data-k="monkey">🐵</span><span class="c" data-k="bear">🐻</span><span class="c" data-k="lion">🦁</span></div>
<div class="subtitle"></div>
<div class="hint">اضغط للمشي</div>
<div class="cross"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="20"/><circle class="ring" cx="28" cy="28" r="20"/></svg><i></i></div>
<div class="note"><b></b><p></p></div>`;
$('#hudL').innerHTML=$('#hudR').innerHTML=hudHTML;

let found=new Set(),lastNote=null,noteTimer=0,muted=false,walking=false,started=false,vr=false;

function setNote(o){
    lastNote=o; clearTimeout(noteTimer);
    $$('.note').forEach(n=>{
        n.querySelector('b').textContent=(o.e?o.e+' ':'')+o.n;
        n.querySelector('p').textContent=o.t;
        n.classList.add('on');
    });
}
function hideNote(){$$('.note').forEach(n=>n.classList.remove('on'))}

function setHint(){
    $$('.hint').forEach(h=>h.textContent = walking ? 'اضغط للتوقف 🛑' : 'اضغط للمشي 🚶');
}

let AC, master, windStarted = false;
function initAudio(){
    AC=new(window.AudioContext||window.webkitAudioContext)();
    master=AC.createGain(); master.gain.value=.55; master.connect(AC.destination);
    
    // صوت خلفية هادئ للغابة (حفيف هواء خفيف جداً)
    if(!windStarted) {
        const bufferSize = AC.sampleRate * 2;
        const noiseBuffer = AC.createBuffer(1, bufferSize, AC.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            output[i] = (Math.random() * 2 - 1) * 0.2; // ضوضاء بيضاء خفيفة
        }
        const wind = AC.createBufferSource();
        wind.buffer = noiseBuffer;
        wind.loop = true;
        
        // استخدام فلتر لتنعيم الصوت وجعله كالهواء
        const filter = AC.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.value = 300;
        filter.Q.value = 0.4;
        
        const windGain = AC.createGain();
        windGain.gain.value = 0.8; // خفيف وغير مزعج
        
        // جعل الهواء يتموج بلطف
        const lfo = AC.createOscillator();
        lfo.frequency.value = 0.15;
        const lfoGain = AC.createGain();
        lfoGain.gain.value = 150;
        lfo.connect(lfoGain);
        lfoGain.connect(filter.frequency);
        lfo.start();

        wind.connect(filter);
        filter.connect(windGain);
        windGain.connect(master);
        wind.start();
        windStarted = true;
    }
}

function tone(o){
    const{type='sine',f0=440,f1=f0,t=0,d=.2,g=.2,lp=0,lfo=0,ld=0}=o,n=AC.currentTime+t,os=AC.createOscillator(),v=AC.createGain();
    os.type=type;os.frequency.setValueAtTime(f0,n);os.frequency.exponentialRampToValueAtTime(f1,n+d);
    v.gain.setValueAtTime(.0001,n);v.gain.linearRampToValueAtTime(g,n+Math.min(.05,d/3));v.gain.exponentialRampToValueAtTime(.001,n+d);
    let out=os;if(lp){const f=AC.createBiquadFilter();f.type='lowpass';f.frequency.value=lp;os.connect(f);out=f}
    out.connect(v);v.connect(master);
    if(lfo){const l=AC.createOscillator(),lg=AC.createGain();l.frequency.value=lfo;lg.gain.value=ld;l.connect(lg);lg.connect(v.gain);l.start(n);l.stop(n+d)}
    os.start(n);os.stop(n+d+.05);
}

const SND={
wood(){for(let i=0;i<9;i++)tone({type:'square',f0:900,f1:300,t:i*.075,d:.05,g:.12,lp:1800})},
monkey(){for(let i=0;i<6;i++)tone({type:'triangle',f0:700+i*60,f1:1500-i*40,t:i*.14,d:.12,g:.22})},
lion(){tone({type:'sawtooth',f0:140,f1:55,d:2.2,g:.5,lp:500,lfo:18,ld:.2});tone({type:'sawtooth',f0:70,f1:45,t:.1,d:2,g:.3,lp:300})},
bear(){tone({type:'sawtooth',f0:95,f1:60,d:1.6,g:.5,lp:380,lfo:30,ld:.25});tone({type:'square',f0:60,f1:45,d:1.5,g:.15,lp:200})}};

setInterval(()=>{if(AC&&!muted&&dayF>.45&&Math.random()<.4){const b=2200+Math.random()*1800,n=2+(Math.random()*3|0);for(let i=0;i<n;i++)tone({f0:b,f1:b*(1.2+Math.random()*.5),t:i*.11,d:.09,g:.04})}},1500);

let voice=null;
const FEM=/hoda|salma|zariyah|laila|layla|amina|fatima|maha|sara|noura|google|female|هدى|سلمى|مها|ليلى/i,MALE=/hamed|hamdan|shakir|maged|majed|naayf|tarik|bassel|\bmale\b|ماجد|طارق/i;
let arVoices=[],vi=0;
function score(x){let s=0;if(/natural|neural|online/i.test(x.name))s+=6;if(FEM.test(x.name))s+=10;if(MALE.test(x.name))s-=20;if(/^ar-SA/i.test(x.lang))s+=2;return s}
function pickVoice(){arVoices=speechSynthesis.getVoices().filter(x=>/^ar/i.test(x.lang)).sort((a,b)=>score(b)-score(a));voice=arVoices.length?arVoices[vi%arVoices.length]:null}
if('speechSynthesis'in window){pickVoice();speechSynthesis.onvoiceschanged=pickVoice}

// دالة النطق التي تظهر النص المنطوق كترجمة
function say(txt,a2,a3){const done=typeof a2==='function'?a2:typeof a3==='function'?a3:null,showSub=!(a2===false||a3===false);
    const subs = $$('.subtitle');
    if(showSub) {
        subs.forEach(s => { s.textContent = txt; s.classList.add('on'); });
    }
    
    const finish = () => {
        if(showSub) subs.forEach(s => s.classList.remove('on'));
        if(done) done();
    };

    if(true){
        setTimeout(finish, txt.length * 60 + 1000);
        return;
    }
    
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(txt);
    u.lang=voice?voice.lang:'ar-SA'; if(voice)u.voice=voice; 
    u.rate=.9; u.pitch=/natural|neural|online/i.test(voice?voice.name:'')?1:1.1;
    
    let fin=false;
    const f=()=>{if(!fin){fin=true; finish();}};
    u.onend=f; u.onerror=f;
    setTimeout(f, txt.length*110+4000);
    speechSynthesis.speak(u);
}

const renderer=new T.WebGLRenderer({antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio,1.75));document.body.prepend(renderer.domElement);
const scene=new T.Scene(),FOG=0x9db8a2;scene.background=new T.Color(FOG);scene.fog=new T.FogExp2(FOG,.03);
const camera=new T.PerspectiveCamera(70,1,.1,120);
const hemi=new T.HemisphereLight(0xcfe8c0,0x2c3b22,.95);scene.add(hemi);
const sun=new T.DirectionalLight(0xfff0c0,.8);sun.position.set(-10,30,10);scene.add(sun);
let sd=7;const rnd=()=>(sd=sd*16807%2147483647)/2147483647;

function ctex(w,h,fn,rx,ry){const c=document.createElement('canvas');c.width=w;c.height=h;fn(c.getContext('2d'),w,h);const t=new T.CanvasTexture(c);t.wrapS=t.wrapT=T.RepeatWrapping;t.repeat.set(rx,ry);return t}
const bark=ctex(128,256,(g,w,h)=>{g.fillStyle='#4a3a2a';g.fillRect(0,0,w,h);
for(let i=0;i<900;i++){g.fillStyle=`rgba(${20+rnd()*40|0},${15+rnd()*30|0},10,.35)`;g.fillRect(rnd()*w,rnd()*h,1+rnd()*2,6+rnd()*20)}
for(let i=0;i<80;i++){g.fillStyle=`rgba(${60+rnd()*30|0},${130+rnd()*50|0},${40+rnd()*30|0},.6)`;g.beginPath();g.arc(rnd()*w,h*(.2+rnd()*.8),6+rnd()*20,0,7);g.fill()}},2,3);
const gt=ctex(256,256,(g,w,h)=>{g.fillStyle='#2b4a22';g.fillRect(0,0,w,h);
for(let i=0;i<1800;i++){const c=rnd();g.fillStyle=c<.5?'rgba(60,110,40,.5)':c<.8?'rgba(90,65,35,.5)':'rgba(30,70,25,.5)';g.beginPath();g.arc(rnd()*w,rnd()*h,1+rnd()*4,0,7);g.fill()}},40,40);
const ground=new T.Mesh(new T.PlaneGeometry(220,220),new T.MeshLambertMaterial({map:gt}));ground.rotation.x=-Math.PI/2;scene.add(ground);

const trees=[],pickables=[],barkM=new T.MeshLambertMaterial({map:bark});
function tree(x,z,r,h){const m=new T.Mesh(new T.CylinderGeometry(r*.7,r*1.15,h,10),barkM);m.position.set(x,h/2,z);scene.add(m);trees.push({x,z,r:r*1.15});pickables.push(m)}
const WT=[-4.5,-11],MT=[8,-8],LC=[-9,6],BC=[9,8];
tree(WT[0],WT[1],.8,26); // شجرة نقار الخشب
tree(MT[0],MT[1],.8,26); // شجرة القرد

const keep=[[0,0,3.5],[LC[0],LC[1],6.5],[BC[0],BC[1],6.5],[WT[0],WT[1],4],[MT[0],MT[1],4]];
for(let i=0,n=0;n<80&&i<500;i++){const a=rnd()*6.28,r=5+Math.sqrt(rnd())*45,x=Math.cos(a)*r,z=Math.sin(a)*r;if(keep.some(k=>Math.hypot(x-k[0],z-k[1])<k[2]))continue;tree(x,z,.45+rnd()*.5,26);n++}
const d=new T.Object3D(),col=new T.Color();

/* سقف الأوراق */
const can=new T.InstancedMesh(new T.IcosahedronGeometry(1,1),new T.MeshLambertMaterial({flatShading:true,emissive:0x16300f}),380);can.frustumCulled=false;
for(let i=0;i<380;i++){const a=rnd()*6.28,r=Math.sqrt(rnd())*58;d.position.set(Math.cos(a)*r,17+rnd()*8,Math.sin(a)*r);d.rotation.set(0,rnd()*3,0);d.scale.set(3+rnd()*4,1.6+rnd()*1.6,3+rnd()*4);d.updateMatrix();can.setMatrixAt(i,d.matrix);can.setColorAt(i,col.setHSL(.25+rnd()*.1,.55,.18+rnd()*.14))}
scene.add(can);
/* سراخس */
const bg=new T.ConeGeometry(.1,1.3,3);bg.translate(0,.65,0);
const fern=new T.InstancedMesh(bg,new T.MeshLambertMaterial(),2800);fern.frustumCulled=false;d.rotation.order='YXZ';
for(let i=0,k=0;i<400;i++){const a=rnd()*6.28,r=2+Math.sqrt(rnd())*48,cx=Math.cos(a)*r,cz=Math.sin(a)*r,sc=.7+rnd()*.9;
for(let j=0;j<7;j++,k++){d.position.set(cx,0,cz);d.rotation.set(1+rnd()*.3,j/7*6.28+rnd()*.4,0);d.scale.set(sc,sc,sc);d.updateMatrix();fern.setMatrixAt(k,d.matrix);fern.setColorAt(k,col.setHSL(.27+rnd()*.08,.6,.2+rnd()*.15))}}
scene.add(fern);d.rotation.order='XYZ';

/* فراشات زرقاء للزينة */
const wg=new T.PlaneGeometry(.16,.12);wg.translate(.08,0,0);const bf=[];
for(let i=0;i<26;i++){const g=new T.Group(),m=new T.MeshBasicMaterial({color:i%3?0x3aa7ff:0x7fd0ff,side:T.DoubleSide}),mk=s=>{const p=new T.Group(),w=new T.Mesh(wg,m);w.rotation.x=-Math.PI/2;w.scale.x=s;p.add(w);g.add(p);return p};
const a=mk(1),b=mk(-1);scene.add(g);const ang=rnd()*6.28,rr=2+rnd()*20;bf.push({g,a,b,c:[Math.cos(ang)*rr,1+rnd()*2.5,Math.sin(ang)*rr],s:.4+rnd()*.5,p:rnd()*6,r:2+rnd()*3})}

const mat=c=>new T.MeshLambertMaterial({color:c,flatShading:true});
function S(p,r,c,x,y,z,sx=1,sy=1,sz=1){const m=new T.Mesh(new T.SphereGeometry(r,12,10),mat(c));m.position.set(x,y,z);m.scale.set(sx,sy,sz);p.add(m);return m}
function B(p,w,h,dp,c,x,y,z){const m=new T.Mesh(new T.BoxGeometry(w,h,dp),mat(c));m.position.set(x,y,z);p.add(m);return m}
function leg(p,x,z,c,w,h){const q=new T.Group();q.position.set(x,h,z);B(q,w,h,w,c,0,-h/2,0);p.add(q);return q}
function mkEye(p, x, y, z, r) {
    const e = S(p, r, 0xffffff, x, y, z); // أبيض العين
    S(e, r*0.5, 0x000000, 0, 0, r*0.8); // بؤبؤ العين
}
function hit(g,k,r,y){const m=new T.Mesh(new T.SphereGeometry(r,6,4),new T.MeshBasicMaterial({visible:false}));m.position.y=y;m.userData.key=k;g.add(m);pickables.push(m)}

// 1. الأسد (ثابت وواقعي)
function mkLion(){
    const g=new T.Group(), tan=0xd9a441, dk=0x5c3a21;
    S(g, .6, tan, 0, 1.0, 0, .85, .85, 1.5); // الجسم ملتحم ومتناسق
    const mane = S(g, .7, dk, 0, 1.5, .6, 1.1, 1.1, 0.7); // اللبدة
    mane.rotation.x = -0.1;
    S(g, .5, tan, 0, 1.5, .8); // الرأس
    S(g, .25, 0xeee8aa, 0, 1.35, 1.1, 1.2, 0.9, 1.1); // الأنف والفم
    S(g, .08, 0x111111, 0, 1.45, 1.35); // الأنف الأسود
    mkEye(g, -0.2, 1.6, 1.2, 0.08); mkEye(g, 0.2, 1.6, 1.2, 0.08); // الأعين
    [-1,1].forEach(s=>S(g, .12, tan, s*.35, 1.85, .7)); // الآذان
    
